createNode expression -n "mouth_M_localRot_expression";
	rename -uid "3B088E17-4E62-6668-E9E4-8BAC9A87E5EE";
	setAttr ".ihi" 0;
	setAttr -k on ".nds";
	setAttr -s 26 ".in[5:25]"  0 0 0 0 0.15 -0.2 0 0 0 0 0 0.15 -0.2 0 
		0 0 0.15 -0.2 0 0 0;
	setAttr -s 14 ".in";
	setAttr -s 32 ".out";
	setAttr ".ixp" -type "string" (
		"float $jawDiffPosUpDown = .I[0];\nfloat $jawDiffRotUpDown = .I[1]*0.1;\n\n\n\n// jaw open secondary L \nfloat $uprSecondaryRUpDownOpenMult = .I[2];\n// corner up down(Y) secondary\nfloat $uprSecondaryRUpDownCornerMult = .I[3];\n// corner left Right(X) secondary\nfloat $uprSecondaryRLeftRightCornerMult = .I[4];\n// compute sum of jaw position and jaw rotation on the upDown axis typical Xrot and translateY and multiply by anim attrs\nfloat $uprSecondaryROuterPrimaryTranslateX = .I[5]*$uprSecondaryRLeftRightCornerMult;\nfloat $uprSecondaryROuterPrimaryTranslateY = .I[6]*$uprSecondaryRUpDownCornerMult;\nfloat $uprSecondaryRSecondaryJawTotal = (($jawDiffRotUpDown * $uprSecondaryRUpDownOpenMult) + ($jawDiffPosUpDown * $uprSecondaryRUpDownOpenMult));\n\nfloat $uprSecondaryRPrimaryOutY= $uprSecondaryROuterPrimaryTranslateY+$uprSecondaryRSecondaryJawTotal;\n.O[0] = $uprSecondaryROuterPrimaryTranslateX;\n.O[1] = $uprSecondaryRPrimaryOutY;\n\nfloat $uprSecondaryRTertiaryTotalOutX = (.I[7] + $uprSecondaryROuterPrimaryTranslateX);\nfloat $uprSecondaryRTertiaryTotalOutY = (.I[8] + $uprSecondaryRPrimaryOutY);\n"
		+ "\n\n// jaw open secondary L \nfloat $uprSecondaryLUpDownOpenMult = .I[9];\n// corner up down(Y) secondary\nfloat $uprSecondaryLUpDownCornerMult = .I[10];\n// corner left Right(X) secondary\nfloat $uprSecondaryLLeftRightCornerMult = .I[11];\n// compute sum of jaw position and jaw rotation on the upDown axis typical Xrot and translateY and multiply by anim attrs\nfloat $uprSecondaryLOuterPrimaryTranslateX = .I[12]*$uprSecondaryLLeftRightCornerMult;\nfloat $uprSecondaryLOuterPrimaryTranslateY = .I[13]*$uprSecondaryLUpDownCornerMult;\nfloat $uprSecondaryLSecondaryJawTotal = (($jawDiffRotUpDown * $uprSecondaryLUpDownOpenMult) + ($jawDiffPosUpDown * $uprSecondaryLUpDownOpenMult));\n\nfloat $uprSecondaryLPrimaryOutY= $uprSecondaryLOuterPrimaryTranslateY+$uprSecondaryLSecondaryJawTotal;\n.O[2] = $uprSecondaryLOuterPrimaryTranslateX;\n.O[3] = $uprSecondaryLPrimaryOutY;\n\nfloat $uprSecondaryLTertiaryTotalOutX = (.I[14] + $uprSecondaryLOuterPrimaryTranslateX);\nfloat $uprSecondaryLTertiaryTotalOutY = (.I[15] + $uprSecondaryLPrimaryOutY);\n"
		+ "\n\n.O[4] = $uprSecondaryRTertiaryTotalOutX* 0.5;\n.O[5] = $uprSecondaryRTertiaryTotalOutY* 0.5;\n\n\n.O[6] = $uprSecondaryRTertiaryTotalOutX* 1.0;\n.O[7] = $uprSecondaryRTertiaryTotalOutY* 1.0;\n\n\n.O[8] = $uprSecondaryRTertiaryTotalOutX* 0.5;\n.O[9] = $uprSecondaryRTertiaryTotalOutY* 0.5;\n\n\n.O[10] = $uprSecondaryLTertiaryTotalOutX* 0.5;\n.O[11] = $uprSecondaryLTertiaryTotalOutY* 0.5;\n\n\n.O[12] = $uprSecondaryLTertiaryTotalOutX* 1.0;\n.O[13] = $uprSecondaryLTertiaryTotalOutY* 1.0;\n\n\n.O[14] = $uprSecondaryLTertiaryTotalOutX* 0.5;\n.O[15] = $uprSecondaryLTertiaryTotalOutY* 0.5;\n\n\n\n// jaw open secondary L \nfloat $lwrSecondaryRUpDownOpenMult = .I[16];\n// corner up down(Y) secondary\nfloat $lwrSecondaryRUpDownCornerMult = .I[17];\n// corner left Right(X) secondary\nfloat $lwrSecondaryRLeftRightCornerMult = .I[18];\n// compute sum of jaw position and jaw rotation on the upDown axis typical Xrot and translateY and multiply by anim attrs\nfloat $lwrSecondaryROuterPrimaryTranslateX = .I[5]*$lwrSecondaryRLeftRightCornerMult;\nfloat $lwrSecondaryROuterPrimaryTranslateY = .I[6]*$lwrSecondaryRUpDownCornerMult;\n"
