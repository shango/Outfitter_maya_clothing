createNode expression -n "arm_r_uprTwistVolumePreservation_expression";
	rename -uid "629F25BA-4EC6-806A-CD7D-E4B378780050";
	setAttr ".ihi" 0;
	setAttr -k on ".nds";
	setAttr -s 14 ".in";
	setAttr -s 14 ".in";
	setAttr -s 6 ".out";
	setAttr ".ixp" -type "string" (
		"float $initialLength = abs(.I[0]);\nfloat $globalScaleX = .I[1];\nfloat $globalScaleY = .I[2];\nfloat $globalScaleZ = .I[3];\n\n\nfloat $uprTwist00SquashValue = .I[4] * 0.2;\n// negative length  can occur with mirrored limb\n\n\nfloat $uprTwist00GlobalScaleNormalizedX = $initialLength / .I[5] * $globalScaleX; \nfloat $uprTwist00GlobalScaleNormalizedY = $initialLength / .I[5] * $globalScaleY; \nfloat $uprTwist00GlobalScaleNormalizedZ = $initialLength / .I[5] * $globalScaleZ;\n// solve negative scale ensure pow is called with absolute value before multiplying back to signed value\nfloat $uprTwist00SignX = ($uprTwist00GlobalScaleNormalizedX < 0) ? -1 : 1;\nfloat $uprTwist00SignY = ($uprTwist00GlobalScaleNormalizedY < 0) ? -1 : 1;\nfloat $uprTwist00SignZ = ($uprTwist00GlobalScaleNormalizedZ < 0) ? -1 : 1;\n\nfloat $uprTwist00PowX = $uprTwist00SignX * pow(abs($uprTwist00GlobalScaleNormalizedX), $uprTwist00SquashValue);\nfloat $uprTwist00PowY = $uprTwist00SignY * pow(abs($uprTwist00GlobalScaleNormalizedY), $uprTwist00SquashValue);\nfloat $uprTwist00PowZ = $uprTwist00SignZ * pow(abs($uprTwist00GlobalScaleNormalizedZ), $uprTwist00SquashValue);\n"
		+ "\n.O[0] = ($uprTwist00PowX * .I[6]) + ((1.0 - .I[6]) * .I[7]);\n.O[1] = ($uprTwist00PowY * .I[6]) + ((1.0 - .I[6]) * .I[8]);\n.O[2] = ($uprTwist00PowZ * .I[6]) + ((1.0 - .I[6]) * .I[9]);\n\n\nfloat $uprTwist01SquashValue = .I[10] * 0.2;\n// negative length  can occur with mirrored limb\n\n\nfloat $uprTwist01GlobalScaleNormalizedX = $initialLength / .I[5] * $globalScaleX; \nfloat $uprTwist01GlobalScaleNormalizedY = $initialLength / .I[5] * $globalScaleY; \nfloat $uprTwist01GlobalScaleNormalizedZ = $initialLength / .I[5] * $globalScaleZ;\n// solve negative scale ensure pow is called with absolute value before multiplying back to signed value\nfloat $uprTwist01SignX = ($uprTwist01GlobalScaleNormalizedX < 0) ? -1 : 1;\nfloat $uprTwist01SignY = ($uprTwist01GlobalScaleNormalizedY < 0) ? -1 : 1;\nfloat $uprTwist01SignZ = ($uprTwist01GlobalScaleNormalizedZ < 0) ? -1 : 1;\n\nfloat $uprTwist01PowX = $uprTwist01SignX * pow(abs($uprTwist01GlobalScaleNormalizedX), $uprTwist01SquashValue);\nfloat $uprTwist01PowY = $uprTwist01SignY * pow(abs($uprTwist01GlobalScaleNormalizedY), $uprTwist01SquashValue);\n"
		+ "float $uprTwist01PowZ = $uprTwist01SignZ * pow(abs($uprTwist01GlobalScaleNormalizedZ), $uprTwist01SquashValue);\n\n.O[3] = ($uprTwist01PowX * .I[6]) + ((1.0 - .I[6]) * .I[11]);\n.O[4] = ($uprTwist01PowY * .I[6]) + ((1.0 - .I[6]) * .I[12]);\n.O[5] = ($uprTwist01PowZ * .I[6]) + ((1.0 - .I[6]) * .I[13]);");
	setAttr ".ani" 0;
